{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Swashbuckle example (Swagger UI)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-swashbuckle-example",
      "program": "${workspaceFolder}/examples/Swashbuckle/bin/Debug/net10.0/Swashbuckle.Example.dll",
      "args": [],
      "cwd": "${workspaceFolder}/examples/Swashbuckle",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5001"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/swagger"
      }
    },
    {
      "name": "OpenAPI + Scalar example",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-openapiscalar-example",
      "program": "${workspaceFolder}/examples/OpenApiScalar/bin/Debug/net10.0/OpenApiScalar.Example.dll",
      "args": [],
      "cwd": "${workspaceFolder}/examples/OpenApiScalar",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5002"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/scalar"
      }
    },
    {
      "name": "OpenAPI + Swagger UI example",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-openapiswaggerui-example",
      "program": "${workspaceFolder}/examples/OpenApiSwaggerUi/bin/Debug/net10.0/OpenApiSwaggerUi.Example.dll",
      "args": [],
      "cwd": "${workspaceFolder}/examples/OpenApiSwaggerUi",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5003"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/swagger"
      }
    },
    {
      "name": ".NET Core Attach",
      "type": "coreclr",
      "request": "attach"
    }
  ],
  "compounds": [
    {
      "name": "All examples (Swagger UI + Scalar + Swagger-over-OpenAPI)",
      "configurations": [
        "Swashbuckle example (Swagger UI)",
        "OpenAPI + Scalar example",
        "OpenAPI + Swagger UI example"
      ],
      "stopAll": true
    }
  ]
}
